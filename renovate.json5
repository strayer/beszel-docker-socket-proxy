{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":disableRateLimiting",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigests"
  ],
  "labels": ["dependencies"],
  "rangeStrategy": "pin",
  "automerge": true,
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "platformAutomerge": true,
  "packageRules": [
    { "matchManagers": ["github-actions"], "groupName": "GitHub Actions" },
    {
      // Go toolchain and the dev tools built against it move together: a newer Go
      // needs a golangci-lint built with it, and Go version sync needs all pins equal
      "groupName": "Go toolchain",
      "matchDepNames": ["go", "golang"]
    },
    { "groupName": "Go toolchain", "matchManagers": ["mise"] },
    {
      // without this the gomod manager never bumps the go directive
      "matchManagers": ["gomod"], "matchDepNames": ["go"], "rangeStrategy": "bump"
    },
    { "matchUpdateTypes": ["major"], "automerge": false },
    {
      // e2e helper images are tracked by tag only; the regex managers have no digest
      // slot, so docker:pinDigests fails to update them
      "matchManagers": ["custom.regex"],
      "matchDatasources": ["docker"],
      "pinDigests": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Bump the e2e fixture image pinned in the test harness",
      "managerFilePatterns": ["/^e2e/harness_test\\.go$/"],
      "matchStrings": [
        "// renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>\\S+)\\nconst fixtureImage = \"[^:\"]+:(?<currentValue>[^\"]+)\""
      ]
    },
    {
      "customType": "regex",
      "description": "Bump the Go toolchain image used by the e2e wrapper",
      "managerFilePatterns": ["/^e2e/run\\.sh$/"],
      "matchStrings": [
        "GO_IMAGE=\"\\$\\{GO_IMAGE:-golang:(?<currentValue>[0-9][0-9.]+)\\}\""
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "golang"
    }
  ]
}
